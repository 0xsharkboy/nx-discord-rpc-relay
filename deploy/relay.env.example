# Discord application id.
DISCORD_CLIENT_ID=1571614802260787280
# Discord application client secret (Developer Portal > OAuth2).
DISCORD_CLIENT_SECRET=changeme
# Base64 of 32 random bytes: openssl rand -base64 32
TOKEN_ENC_KEY=changeme
# Optional admin key for icon moderation: openssl rand -base64 32
#ADMIN_KEY=changeme
# Public URL of the relay, no trailing slash (icons are served from it).
PUBLIC_BASE_URL=https://nx-discord-rpc.0xsharkboy.dev
# Distinct voters needed to publish an icon.
PUBLISH_THRESHOLD=2
# The documented setup puts a reverse proxy in front of 127.0.0.1:8080: keep true so that rate
# limits key on each console's address instead of the proxy's. The proxy MUST overwrite
# X-Forwarded-For with the peer address, never append to it, or clients can pick their own key:
#   nginx: proxy_set_header X-Forwarded-For $remote_addr;  (never $proxy_add_x_forwarded_for)
#   Caddy: reverse_proxy already replaces X-Forwarded-For from untrusted clients by default.
# Set false only when clients reach the relay directly.
TRUST_PROXY=true
# Listen address inside the container.
LISTEN_ADDR=0.0.0.0:8080
# Data directory inside the container; keep in sync with the compose volume.
DATA_DIR=/data
